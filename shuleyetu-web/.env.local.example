# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ClickPesa (keep real values secret; do NOT commit .env.local)
CLICKPESA_BASE_URL="https://api.clickpesa.com"
CLICKPESA_CLIENT_ID="your-clickpesa-client-id"
CLICKPESA_API_KEY="your-clickpesa-api-key"
CLICKPESA_ENV="sandbox" # or "production"
CLICKPESA_WEBHOOK_SECRET="your-clickpesa-webhook-secret"

# Africa's Talking (SMS/WhatsApp notifications)
AFRICAS_TALKING_API_KEY="your-africastalking-api-key"
AFRICAS_TALKING_USERNAME="your-africastalking-username"

# Sentry (error monitoring)
SENTRY_DSN="https://your-key@sentry.io/your-project"
SENTRY_ORG="your-sentry-org"
SENTRY_PROJECT="your-sentry-project"
SENTRY_AUTH_TOKEN="your-sentry-auth-token"

# CSRF protection
CSRF_SECRET="your-csrf-secret-key-change-in-production"

# App metadata
APP_VERSION="1.0.0"
LOG_LEVEL="info"
